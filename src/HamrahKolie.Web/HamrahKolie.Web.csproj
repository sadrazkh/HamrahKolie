  <!-- پروژه فرانت‌اند (Vite/Vue) توسط dotnet کامپایل نمی‌شود؛ خروجی آن در wwwroot/dist است. -->
  <ItemGroup>
    <Compile Remove="ClientApp\**" />
    <Content Remove="ClientApp\**" />
    <None Remove="ClientApp\**" />
