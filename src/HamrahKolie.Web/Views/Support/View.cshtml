@using HamrahKolie.Web.Helpers
@model HamrahKolie.Web.ViewModels.SupportViewPageModel
@{
    ViewData["Title"] = "وضعیت درخواست";
    var r = Model.Request;
    var faCulture = new System.Globalization.CultureInfo("fa-IR");
}
<section class="section">
    <div class="container" style="max-width:720px">
        @if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }

        <div class="d-flex justify-between items-center flex-wrap">
            <h1 class="mb-0">درخواست <span dir="ltr">@r.TrackingCode</span></h1>
            <span class="badge badge-primary" style="font-size:1rem">@SupportRequestDisplay.Status(r.Status)</span>
        </div>

        <div class="card" style="margin-top:1rem">
            <h3 class="mt-0">خلاصه</h3>
            <div class="d-flex justify-between"><span class="text-muted">نام</span><strong>@r.ApplicantName</strong></div>
            <div class="d-flex justify-between"><span class="text-muted">نوع نیاز</span><strong>@(r.NeedType ?? "—")</strong></div>
            <div class="d-flex justify-between"><span class="text-muted">تاریخ ثبت</span><strong dir="ltr">@r.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")</strong></div>
        </div>

        <div class="card">
            <h3 class="mt-0">مراحل بررسی</h3>
            @foreach (var h in r.History)
            {
                <div class="d-flex gap-4" style="border-inline-start:2px solid var(--c-primary-300);padding:.4rem 0 .4rem 0;padding-inline-start:1rem;margin-inline-start:.3rem">
                    <div style="min-width:130px" class="text-muted" dir="ltr">@h.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</div>
                    <div><strong>@SupportRequestDisplay.Status(h.ToStatus)</strong>@if (!string.IsNullOrWhiteSpace(h.Note)) { <div class="text-muted">@h.Note</div> }</div>
                </div>
            }
        </div>

        <div class="card">
            <h3 class="mt-0">گفت‌وگو با کارشناسان</h3>
            @if (!r.Messages.Any())
            {
                <p class="text-muted">هنوز پیامی وجود ندارد.</p>
            }
            else
            {
                foreach (var m in r.Messages)
                {
                    <div class="alert @(m.IsFromApplicant ? "alert-info" : "alert-success")">
                        <div style="font-size:.8rem" class="text-muted">@(m.IsFromApplicant ? "شما" : "کارشناس") — @m.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</div>
                        @m.Body
                    </div>
                }
            }

            <form asp-action="Reply" method="post" style="margin-top:1rem">
                @Html.AntiForgeryToken()
                <input type="hidden" name="code" value="@r.TrackingCode" />
                <input type="hidden" name="requestId" value="@r.Id" />
                <div class="form-group">
                    <label class="form-label">پاسخ / پیام شما</label>
                    <textarea class="form-control" name="body" rows="2" required></textarea>
                </div>
                <button type="submit" class="btn btn-primary">ارسال پیام</button>
            </form>
        </div>

        <div class="card">
            <h3 class="mt-0">مدارک</h3>
            @if (r.Documents.Any())
            {
                <ul>
                    @foreach (var d in r.Documents)
                    {
                        <li>
                            @if (d.MediaFile != null) { <a href="@d.MediaFile.Url" target="_blank" rel="noopener">@d.Title</a> }
                            else { @d.Title }
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted">هنوز مدرکی بارگذاری نشده است.</p>
            }

            <form asp-action="Upload" method="post" enctype="multipart/form-data" style="border-top:1px solid var(--c-border);padding-top:1rem;margin-top:.5rem">
                @Html.AntiForgeryToken()
                <input type="hidden" name="code" value="@r.TrackingCode" />
                <input type="hidden" name="requestId" value="@r.Id" />
                <div class="form-group">
                    <label class="form-label">عنوان مدرک</label>
                    <input class="form-control" name="title" placeholder="مثلاً برگه آزمایش" />
                </div>
                <div class="form-group">
                    <input class="form-control" type="file" name="file" accept="image/*,application/pdf" required />
                </div>
                <button type="submit" class="btn btn-outline">بارگذاری مدرک</button>
            </form>
        </div>
    </div>
</section>
