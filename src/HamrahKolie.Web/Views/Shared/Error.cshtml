@model ErrorViewModel
@{
    ViewData["Title"] = "خطا";
}
<section class="section">
    <div class="container text-center" style="max-width:640px">
        <h1>خطایی رخ داد</h1>
        <p class="lead">متأسفیم؛ در پردازش درخواست شما مشکلی پیش آمد. لطفاً کمی بعد دوباره تلاش کنید.</p>
        @if (Model.ShowRequestId)
        {
            <p class="text-muted">شناسه پیگیری: <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">بازگشت به صفحه اصلی</a>
    </div>
</section>
