@using HamrahKolie.Application.PageBuilder
@using HamrahKolie.Domain.Entities
@using HamrahKolie.Domain.Enums
@inject HamrahKolie.Application.Cms.IContentService ContentService
@model PageSection
@{
    var style = Model.GetStyle();
    var background = style.BackgroundColor ?? (Model.Background switch
    {
        SectionBackground.Surface => "#ffffff",
        SectionBackground.Tint => "#eef7f0",
        SectionBackground.Dark => "#1f2a24",
        _ => null
    });
    var textColor = style.TextColor ?? (Model.Background == SectionBackground.Dark ? "#e6efe9" : null);
    var shadow = style.Shadow switch
    {
        "small" => "0 4px 14px rgba(31,42,36,.08)",
        "medium" => "0 12px 34px rgba(31,42,36,.14)",
        "large" => "0 22px 60px rgba(31,42,36,.2)",
        _ => "none"
    };
    var sectionStyle = string.Join(";", new[]
    {
        background is null ? null : $"background-color:{background}",
        textColor is null ? null : $"color:{textColor}",
        $"text-align:{style.TextAlign}",
        $"min-height:{style.MinHeight}px",
        $"padding:{style.PaddingTop}px {style.PaddingInline}px {style.PaddingBottom}px",
        $"margin-top:{style.MarginTop}px",
        $"margin-bottom:{style.MarginBottom}px",
        $"border-radius:{style.BorderRadius}px",
        $"box-shadow:{shadow}",
        $"--pb-accent:{style.AccentColor ?? "var(--c-primary-500)"}",
    }.Where(x => x is not null));
    var visibility = (!Model.ShowOnMobile ? "hide-mobile " : "") + (!Model.ShowOnDesktop ? "hide-desktop " : "");
    var customClass = style.CssClass ?? "";
    var animationClass = style.Animation == "none" ? "" : $"pb-animate-{style.Animation}";
    var contentStyle = $"max-width:{style.ContentWidth}px";
}

@if (Model.Type == SectionType.Spacer)
{
    <div class="pb-section pb-spacer @visibility @customClass" data-pb-section-id="@Model.Id" style="height:@(Math.Max(style.MinHeight, 32))px" aria-hidden="true"></div>
}
else if (Model.Type == SectionType.Divider)
{
    <section class="pb-section pb-divider @visibility @customClass" data-pb-section-id="@Model.Id" style="@sectionStyle">
        <div class="pb-section__container" style="@contentStyle"><hr /></div>
    </section>
}
else
{
    <section class="pb-section pb-section--@Model.Type.ToString().ToLowerInvariant() @visibility @customClass @animationClass"
             data-pb-section-id="@Model.Id" data-pb-section-type="@Model.Type" style="@sectionStyle">
        <div class="pb-section__container" style="@contentStyle">
            @switch (Model.Type)
            {
                case SectionType.Hero:
                    <div class="pb-hero">
                        <div class="pb-hero__content">
                            @if (!string.IsNullOrWhiteSpace(Model.Title)) { <h1>@Model.Title</h1> }
                            @if (!string.IsNullOrWhiteSpace(Model.Subtitle)) { <p class="lead">@Model.Subtitle</p> }
                            <div class="pb-actions">
                                @if (!string.IsNullOrWhiteSpace(Model.ButtonText)) { <a class="btn btn-primary btn-lg" href="@Model.ButtonUrl">@Model.ButtonText</a> }
                                @if (!string.IsNullOrWhiteSpace(Model.SecondaryButtonText)) { <a class="btn btn-outline btn-lg" href="@Model.SecondaryButtonUrl">@Model.SecondaryButtonText</a> }
                            </div>
                        </div>
                        @if (Model.Image is not null)
                        {
                            <img class="pb-hero__image" src="@Model.Image.Url" alt="@Model.Title" />
                        }
                    </div>
                    break;

                case SectionType.Heading:
                    <div class="pb-heading">
                        @if (!string.IsNullOrWhiteSpace(Model.Title)) { <h2>@Model.Title</h2> }
                        @if (!string.IsNullOrWhiteSpace(Model.Subtitle)) { <p>@Model.Subtitle</p> }
                    </div>
                    break;

                case SectionType.ImageText:
                    <div class="pb-image-text">
                        @if (Model.Image is not null) { <img src="@Model.Image.Url" alt="@Model.Title" loading="lazy" /> }
                        <div>
                            @if (!string.IsNullOrWhiteSpace(Model.Title)) { <h2>@Model.Title</h2> }
                            @if (!string.IsNullOrWhiteSpace(Model.Subtitle)) { <p class="lead">@Model.Subtitle</p> }
                            @if (!string.IsNullOrWhiteSpace(Model.Body)) { <div class="content-body">@Html.Raw(Model.Body)</div> }
                            @if (!string.IsNullOrWhiteSpace(Model.ButtonText)) { <a class="btn btn-primary" href="@Model.ButtonUrl">@Model.ButtonText</a> }
                        </div>
                    </div>
                    break;

                case SectionType.Stats:
                    @if (!string.IsNullOrWhiteSpace(Model.Title)) { <h2>@Model.Title</h2> }
                    @if (!string.IsNullOrWhiteSpace(Model.Subtitle)) { <p class="text-muted">@Model.Subtitle</p> }
                    <div class="pb-stats">
                        @foreach (var item in Model.GetStats())
                        {
                            <div class="stat"><div class="stat-value">@item.Value</div><div class="stat-label">@item.Label</div></div>
                        }
                    </div>
                    break;

                case SectionType.FeatureCards:
                    @if (!string.IsNullOrWhiteSpace(Model.Title)) { <h2>@Model.Title</h2> }
                    @if (!string.IsNullOrWhiteSpace(Model.Subtitle)) { <p class="text-muted">@Model.Subtitle</p> }
                    <div class="pb-cards">
                        @foreach (var item in Model.GetCards())
                        {
                            <article class="card card-hover"><h3>@item.Title</h3><p class="text-muted mb-0">@item.Text</p></article>
                        }
                    </div>
                    break;

                case SectionType.Steps:
                    @if (!string.IsNullOrWhiteSpace(Model.Title)) { <h2>@Model.Title</h2> }
                    @if (!string.IsNullOrWhiteSpace(Model.Subtitle)) { <p class="text-muted">@Model.Subtitle</p> }
                    <div class="pb-steps">
                        @{ var stepNumber = 1; }
                        @foreach (var item in Model.GetCards())
                        {
                            <div class="step"><div class="step-num">@stepNumber</div><h3>@item.Title</h3><p class="text-muted mb-0">@item.Text</p></div>
                            stepNumber++;
                        }
                    </div>
                    break;

                case SectionType.Faq:
                    @if (!string.IsNullOrWhiteSpace(Model.Title)) { <h2>@Model.Title</h2> }
                    @if (!string.IsNullOrWhiteSpace(Model.Subtitle)) { <p class="text-muted">@Model.Subtitle</p> }
                    <div class="pb-faq">
                        @foreach (var item in Model.GetCards())
                        {
                            <details><summary>@item.Title</summary><p>@item.Text</p></details>
                        }
                    </div>
                    break;

                case SectionType.Video:
                    @if (!string.IsNullOrWhiteSpace(Model.Title)) { <h2>@Model.Title</h2> }
                    @if (!string.IsNullOrWhiteSpace(Model.Subtitle)) { <p class="text-muted">@Model.Subtitle</p> }
                    @if (Model.Image is not null && Model.Image.ContentType.StartsWith("video/"))
                    {
                        <video class="pb-video" controls preload="metadata"><source src="@Model.Image.Url" type="@Model.Image.ContentType" /></video>
                    }
                    else if (!string.IsNullOrWhiteSpace(Model.ButtonUrl))
                    {
                        <video class="pb-video" controls preload="metadata" src="@Model.ButtonUrl"></video>
                    }
                    break;

                case SectionType.CallToAction:
                    <div class="pb-cta">
                        @if (!string.IsNullOrWhiteSpace(Model.Title)) { <h2>@Model.Title</h2> }
                        @if (!string.IsNullOrWhiteSpace(Model.Subtitle)) { <p>@Model.Subtitle</p> }
                        @if (!string.IsNullOrWhiteSpace(Model.ButtonText)) { <a class="btn btn-accent btn-lg" href="@Model.ButtonUrl">@Model.ButtonText</a> }
                    </div>
                    break;

                case SectionType.RichText:
                    @if (!string.IsNullOrWhiteSpace(Model.Title)) { <h2>@Model.Title</h2> }
                    <div class="content-body">@Html.Raw(Model.Body)</div>
                    break;

                case SectionType.LatestContent:
                    {
                        IReadOnlyList<Content> news = Array.Empty<Content>();
                        IReadOnlyList<Content> articles = Array.Empty<Content>();
                        try
                        {
                            var count = Model.GetCount(3);
                            news = await ContentService.GetLatestPublishedAsync(ContentType.News, count);
                            articles = await ContentService.GetLatestPublishedAsync(ContentType.Article, count);
                        }
                        catch { }
                        if (!string.IsNullOrWhiteSpace(Model.Title)) { <h2>@Model.Title</h2> }
                        if (!string.IsNullOrWhiteSpace(Model.Subtitle)) { <p class="text-muted">@Model.Subtitle</p> }
                        <div class="pb-cards">
                            @foreach (var item in news)
                            {
                                <article class="card card-hover"><span class="badge badge-primary">خبر</span><h3><a href="/news/@item.Slug">@item.Title</a></h3><p class="text-muted mb-0">@item.Summary</p></article>
                            }
                            @foreach (var item in articles)
                            {
                                <article class="card card-hover"><span class="badge">مقاله</span><h3><a href="/articles/@item.Slug">@item.Title</a></h3><p class="text-muted mb-0">@item.Summary</p></article>
                            }
                        </div>
                    }
                    break;
            }
        </div>
    </section>
}
