@using HamrahKolie.Domain.Enums
@{
    var orgName = "همراه کلیه";
    var centerName = ViewData["CenterName"] as string;
    var features = ViewData["Features"] as HospitalFeature? ?? HospitalFeature.None;
    bool Has(HospitalFeature f) => (features & f) == f;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "پورتال مرکز درمانی") — @orgName</title>
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" href="~/img/logo.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@@v33.003/Vazirmatn-font-face.css" />
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="admin-topbar">
        <a class="d-flex items-center gap-2" asp-controller="Hospital" asp-action="Index" style="font-weight:800;color:var(--c-text)">
            <img src="~/img/logo.svg" alt="" style="width:32px" />
            <span>پورتال مرکز درمانی@(string.IsNullOrEmpty(centerName) ? "" : $" — {centerName}")</span>
        </a>
        <div class="d-flex items-center gap-4">
            <a class="btn btn-ghost" asp-controller="Hospital" asp-action="Index">بیماران</a>
            @if (Has(HospitalFeature.ExportPatients)) { <a class="btn btn-ghost" asp-controller="Hospital" asp-action="Export">خروجی CSV</a> }
            @if (Has(HospitalFeature.PatientRegistration)) { <a class="btn btn-primary" asp-controller="Hospital" asp-action="New">+ ثبت بیمار جدید</a> }
            <form asp-controller="Account" asp-action="Logout" method="post" class="mb-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline">خروج</button>
            </form>
        </div>
    </div>
    <div class="container" style="padding:1.5rem 0">
        @if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }
        @if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }
        @RenderBody()
    </div>
</body>
</html>
