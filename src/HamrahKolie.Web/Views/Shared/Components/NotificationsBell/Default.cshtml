@model HamrahKolie.Web.ViewComponents.BellModel
<div class="bell" style="position:relative">
    <a href="/Admin/Notifications" class="bell-btn" title="اعلان‌ها" style="position:relative;font-size:1.3rem;text-decoration:none">
        🔔
        @if (Model.UnreadCount > 0)
        {
            <span style="position:absolute;top:-6px;inset-inline-start:-6px;background:var(--c-danger);color:#fff;border-radius:999px;font-size:.7rem;padding:1px 5px;font-weight:700">
                @(Model.UnreadCount > 9 ? "+9" : Model.UnreadCount.ToString("N0", new System.Globalization.CultureInfo("fa-IR")))
            </span>
        }
    </a>
</div>
