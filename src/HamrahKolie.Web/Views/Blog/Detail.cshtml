@using HamrahKolie.Domain.Entities
@using HamrahKolie.Domain.Enums
@model Content
@{
    var faCulture = new System.Globalization.CultureInfo("fa-IR");
    var published = (Model.PublishedAt ?? Model.CreatedAt).ToLocalTime();
    var isEducational = Model.Type is ContentType.Article or ContentType.PatientStory;
}
<section class="section">
    <div class="container" style="max-width:820px">
        <nav class="text-muted" style="font-size:.9rem;margin-bottom:1rem">
            <a href="/">خانه</a>
            @if (Model.Type == ContentType.News) { <span>/ <a href="/news">اخبار</a></span> }
            else if (Model.Type == ContentType.Article) { <span>/ <a href="/articles">مقالات</a></span> }
            <span>/ @Model.Title</span>
        </nav>

        <h1>@Model.Title</h1>
        <div class="d-flex gap-4 text-muted flex-wrap" style="font-size:.9rem;margin-bottom:1.5rem">
            <span>📅 @published.ToString("d MMMM yyyy", faCulture)</span>
            @if (Model.Category != null) { <span class="badge badge-primary">@Model.Category.Name</span> }
            @if (Model.LastReviewedAt != null) { <span>بازبینی: @Model.LastReviewedAt.Value.ToLocalTime().ToString("yyyy/MM/dd")</span> }
        </div>

        @if (Model.FeaturedImage != null)
        {
            <img src="@Model.FeaturedImage.Url" alt="@(Model.FeaturedImage.Alt ?? Model.Title)"
                 style="width:100%;border-radius:var(--radius);margin-bottom:1.5rem" />
        }

        @if (!string.IsNullOrWhiteSpace(Model.Summary))
        {
            <p class="lead">@Model.Summary</p>
        }

        <div class="content-body">
            @Html.Raw(Model.Body)
        </div>

        @if (Model.ContentTags.Any())
        {
            <div class="d-flex gap-2 flex-wrap" style="margin-top:2rem">
                @foreach (var t in Model.ContentTags)
                {
                    <a class="badge" href="/articles?tag=@t.Tag.Slug">#@t.Tag.Name</a>
                }
            </div>
        }

        @if (isEducational)
        {
            <div class="alert alert-info" style="margin-top:2rem">
                این مطلب جنبه آموزشی دارد و جایگزین مشاوره، تشخیص یا درمان پزشک نیست. برای تصمیم‌های درمانی حتماً با پزشک خود مشورت کنید.
            </div>
        }
    </div>
</section>

@section Scripts {
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "@(Model.Type == ContentType.News ? "NewsArticle" : "Article")",
      "headline": "@Model.Title",
      "datePublished": "@published.ToString("yyyy-MM-dd")",
      "inLanguage": "fa-IR",
      "publisher": { "@@type": "Organization", "name": "همراه کلیه" }
    }
    </script>
}
