@using HamrahKolie.Application.Common.Models
@using HamrahKolie.Domain.Entities
@model PagedResult<Content>
@{
    var title = ViewData["Title"] as string ?? "فهرست";
    var routeBase = ViewData["RouteBase"] as string ?? "news";
    string Detail(Content c) => $"/{routeBase}/{c.Slug}";
}
<section class="section">
    <div class="container">
        <h1>@title</h1>

        @if (Model.Items.Count == 0)
        {
            <div class="card empty-state">هنوز محتوایی منتشر نشده است.</div>
        }
        else
        {
            <div class="grid grid-3" style="margin-top:1.5rem">
                @foreach (var c in Model.Items)
                {
                    <article class="card card-hover">
                        @if (c.FeaturedImage != null)
                        {
                            <img src="@c.FeaturedImage.Url" alt="@(c.FeaturedImage.Alt ?? c.Title)"
                                 loading="lazy" style="width:100%;height:180px;object-fit:cover;border-radius:var(--radius-sm);margin-bottom:1rem" />
                        }
                        <h3><a href="@Detail(c)">@c.Title</a></h3>
                        @if (c.Category != null)
                        {
                            <span class="badge badge-primary">@c.Category.Name</span>
                        }
                        <p class="text-muted" style="margin-top:.6rem">@c.Summary</p>
                        <a class="btn btn-outline" href="@Detail(c)">ادامه مطلب</a>
                    </article>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="d-flex gap-2 justify-between" style="margin-top:2rem">
                    <div>
                        @if (Model.HasPrevious)
                        {
                            <a class="btn btn-outline" href="/@routeBase?page=@(Model.Page - 1)">→ قبلی</a>
                        }
                    </div>
                    <span class="text-muted">صفحه @Model.Page از @Model.TotalPages</span>
                    <div>
                        @if (Model.HasNext)
                        {
                            <a class="btn btn-outline" href="/@routeBase?page=@(Model.Page + 1)">بعدی ←</a>
                        }
                    </div>
                </div>
            }
        }
    </div>
</section>
