@using HamrahKolie.Domain.Entities
@using HamrahKolie.Domain.Enums
@model Donation
@{
    ViewData["Title"] = "رسید حمایت";
    var faCulture = new System.Globalization.CultureInfo("fa-IR");
}
<section class="section">
    <div class="container" style="max-width:560px">
        <div class="card text-center">
            <div style="font-size:3rem">✅</div>
            <h1>سپاسگزاریم!</h1>
            <p class="lead">کمک شما با موفقیت ثبت شد و همراهِ بیماران دیالیزی خواهد بود.</p>

            <div style="text-align:start;border-top:1px solid var(--c-border);margin-top:1rem;padding-top:1rem">
                <div class="d-flex justify-between"><span class="text-muted">کد پیگیری</span><strong dir="ltr">@Model.TrackingCode</strong></div>
                <div class="d-flex justify-between"><span class="text-muted">مبلغ</span><strong>@Model.Amount.ToString("N0", faCulture) تومان</strong></div>
                <div class="d-flex justify-between"><span class="text-muted">وضعیت</span>
                    <strong>@(Model.Status == PaymentStatus.Succeeded ? "پرداخت‌شده" : "در انتظار")</strong>
                </div>
                @if (Model.Payment?.ReferenceId != null)
                {
                    <div class="d-flex justify-between"><span class="text-muted">کد مرجع بانک</span><strong dir="ltr">@Model.Payment.ReferenceId</strong></div>
                }
                @if (Model.Campaign != null)
                {
                    <div class="d-flex justify-between"><span class="text-muted">کمپین</span><strong>@Model.Campaign.Title</strong></div>
                }
            </div>

            <div class="d-flex gap-2" style="margin-top:1.5rem">
                <button type="button" class="btn btn-outline" onclick="window.print()">چاپ رسید</button>
                <a class="btn btn-primary" href="/">بازگشت به خانه</a>
            </div>
        </div>
    </div>
</section>
