{
  "ConnectionStrings": {
    "Default": "ConnectionStrings__Default = Host=<PGHOST>;Port=5432;Username=<PGUSER>;Password=<PGPASSWORD>;Database=<PGDATABASE>"
  },
  "Database": {
    "Provider": "PostgreSql"
  },
  "SuperAdmin": {
    "Email": "",
    "Password": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
