@using HamrahKolie.Domain.Entities
@model IReadOnlyList<FormDefinition>
@{
    ViewData["Title"] = "فرم‌ها";
}
<div class="d-flex justify-between items-center" style="margin-bottom:1rem">
    <p class="text-muted mb-0">فرم‌های عمومی سایت را بسازید و مدیریت کنید.</p>
    <a class="btn btn-primary" asp-action="Create">+ فرم جدید</a>
</div>
<div class="card">
    @if (Model.Count == 0)
    {
        <div class="empty-state"><p>فرمی ساخته نشده است.</p><a class="btn btn-primary" asp-action="Create">ساخت فرم</a></div>
    }
    else
    {
        <table class="table">
            <thead><tr><th>عنوان</th><th>نشانی عمومی</th><th>فیلدها</th><th>وضعیت</th><th></th></tr></thead>
            <tbody>
                @foreach (var f in Model)
                {
                    <tr>
                        <td><a asp-action="Edit" asp-route-id="@f.Id"><strong>@f.Title</strong></a></td>
                        <td dir="ltr"><a href="/forms/@f.Slug" target="_blank">/forms/@f.Slug</a></td>
                        <td>@f.Fields.Count.ToString("N0", new System.Globalization.CultureInfo("fa-IR"))</td>
                        <td>@(f.IsEnabled ? Html.Raw("<span class=\"badge badge-primary\">فعال</span>") : Html.Raw("<span class=\"badge\">غیرفعال</span>"))</td>
                        <td>
                            <div class="d-flex gap-2">
                                <a class="btn btn-outline" asp-action="Edit" asp-route-id="@f.Id">ویرایش</a>
                                <a class="btn btn-ghost" asp-action="Submissions" asp-route-id="@f.Id">پاسخ‌ها</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
