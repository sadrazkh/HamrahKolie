@using System.Text.Json
@using HamrahKolie.Domain.Entities
@model FormSubmission
@{
    ViewData["Title"] = "پاسخ فرم";
    Dictionary<string, string> data = new();
    try { data = JsonSerializer.Deserialize<Dictionary<string, string>>(Model.DataJson) ?? new(); } catch { }
    var labels = Model.Form?.Fields?.ToDictionary(f => f.Name, f => f.Label) ?? new();
}
<div class="grid" style="grid-template-columns: 1fr 280px; gap:1.5rem; align-items:start">
    <div class="card">
        <h3 class="mt-0">پاسخ به «@Model.Form?.Title»</h3>
        <p class="text-muted" dir="ltr">@Model.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</p>
        <table class="table">
            @foreach (var kv in data)
            {
                <tr>
                    <th style="width:35%">@(labels.TryGetValue(kv.Key, out var l) ? l : kv.Key)</th>
                    <td>@kv.Value</td>
                </tr>
            }
        </table>
    </div>
    <div class="stack">
        <div class="card">
            <h3 class="mt-0">وضعیت</h3>
            <p>@(Model.IsReviewed ? "بررسی‌شده" : "جدید")</p>
            @if (!Model.IsReviewed)
            {
                <form asp-action="MarkReviewed" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary btn-block">علامت‌گذاری به‌عنوان بررسی‌شده</button>
                </form>
            }
        </div>
        <a class="btn btn-ghost btn-block" asp-action="Submissions" asp-route-id="@Model.FormDefinitionId">بازگشت</a>
    </div>
</div>
