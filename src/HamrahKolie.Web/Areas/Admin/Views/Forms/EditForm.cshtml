@model HamrahKolie.Application.Forms.FormInput
@{
    ViewData["Title"] = "فرم جدید";
}
<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="@(ViewData.ModelState.ErrorCount == 0 ? "display:none" : "")"></div>
    <div class="card" style="max-width:640px">
        <div class="form-group">
            <label class="form-label">عنوان فرم</label>
            <input class="form-control" asp-for="Title" required />
        </div>
        <div class="form-group">
            <label class="form-label">نامک (اختیاری)</label>
            <input class="form-control" asp-for="Slug" dir="ltr" />
        </div>
        <div class="form-group">
            <label class="form-label">توضیح</label>
            <textarea class="form-control" asp-for="Description" rows="2"></textarea>
        </div>
        <div class="form-group">
            <label class="form-label">پیام موفقیت</label>
            <input class="form-control" asp-for="SuccessMessage" />
        </div>
        <div class="grid grid-2">
            <div class="form-group"><label class="form-label">متن دکمه ارسال</label><input class="form-control" asp-for="SubmitLabel" /></div>
        </div>
        <label class="d-flex items-center gap-2" style="font-weight:600;margin-bottom:.5rem"><input type="checkbox" asp-for="IsEnabled" checked /> فعال</label>
        <label class="d-flex items-center gap-2" style="font-weight:600;margin-bottom:1rem"><input type="checkbox" asp-for="NotifyStaff" checked /> اطلاع به کارکنان هنگام ثبت پاسخ</label>
        <button type="submit" class="btn btn-primary">ایجاد فرم</button>
    </div>
</form>
