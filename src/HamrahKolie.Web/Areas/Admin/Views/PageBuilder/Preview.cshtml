@using HamrahKolie.Domain.Entities
@model IReadOnlyList<PageSection>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "پیش‌نمایش صفحه اصلی";
    ViewData["Robots"] = "noindex,nofollow";
}

<div style="position:sticky;top:0;z-index:100;background:#b8860b;color:#fff;text-align:center;padding:.6rem;font-weight:700">
    حالت پیش‌نمایش — شامل سکشن‌های فعال (پیش‌نویس و منتشرشده). این نسخه برای عموم نمایش داده نمی‌شود.
</div>

@if (Model.Count == 0)
{
    <section class="section"><div class="container empty-state">هیچ سکشن فعالی برای پیش‌نمایش وجود ندارد.</div></section>
}
else
{
    foreach (var section in Model)
    {
        <partial name="_PageSection" model="section" />
    }
}
