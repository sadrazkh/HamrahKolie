@model IReadOnlyList<UserListItem>
@{
    ViewData["Title"] = "کاربران";
    bool Can(string p) => User.HasClaim("permission", "*") || User.HasClaim("permission", p);
}
@if (Can(Permissions.UserManage))
{
    <div class="d-flex justify-between items-center" style="margin-bottom:1rem">
        <p class="text-muted mb-0">مدیریت کاربران سامانه.</p>
        <a class="btn btn-primary" asp-action="CreateHospital">+ حساب مرکز درمانی</a>
    </div>
}
<div class="card">
    @if (Model.Count == 0)
    {
        <div class="empty-state">هنوز کاربری ثبت نشده است.</div>
    }
    else
    {
        <table class="table">
            <thead><tr><th>نام</th><th>ایمیل</th><th>نقش‌ها</th><th>وضعیت</th><th>آخرین ورود</th></tr></thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@(string.IsNullOrWhiteSpace(u.FullName) ? "—" : u.FullName)</td>
                        <td dir="ltr">@u.Email</td>
                        <td>@u.Roles</td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge badge-primary">فعال</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">غیرفعال</span>
                            }
                        </td>
                        <td dir="ltr">@(u.LastLoginAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
