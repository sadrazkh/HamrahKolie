@model IReadOnlyList<HamrahKolie.Domain.Entities.AuditLog>
@{
    ViewData["Title"] = "گزارش رویدادها";
    var page = ViewData["Page"] as int? ?? 1;
    var totalPages = ViewData["TotalPages"] as int? ?? 1;
}
<div class="card">
    @if (Model.Count == 0)
    {
        <div class="empty-state">هنوز رویدادی ثبت نشده است.</div>
    }
    else
    {
        <table class="table">
            <thead><tr><th>زمان</th><th>عملیات</th><th>کاربر</th><th>IP</th><th>توضیح</th></tr></thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td dir="ltr">@a.OccurredAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss")</td>
                        <td><span class="badge badge-primary">@a.Action</span></td>
                        <td>@(a.UserName ?? "—")</td>
                        <td dir="ltr">@(a.IpAddress ?? "—")</td>
                        <td>@(a.Description ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (totalPages > 1)
        {
            <div class="d-flex gap-2" style="margin-top:1rem">
                @if (page > 1)
                {
                    <a class="btn btn-outline" asp-action="Index" asp-route-page="@(page - 1)">قبلی</a>
                }
                <span class="btn btn-ghost">صفحه @(page) از @(totalPages)</span>
                @if (page < totalPages)
                {
                    <a class="btn btn-outline" asp-action="Index" asp-route-page="@(page + 1)">بعدی</a>
                }
            </div>
        }
    }
</div>
