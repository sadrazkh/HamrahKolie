# ── نمونه متغیرهای محیطی «همراه کلیه» ──────────────────────────────
# این فایل را به .env کپی کنید و مقادیر واقعی را جایگزین کنید.
# هیچ‌گاه مقادیر واقعی (Secret) را در گیت قرار ندهید.

# پایگاه داده (PostgreSql یا SqlServer)
Database__Provider=PostgreSql
ConnectionStrings__Default=Host=db;Port=5432;Database=hamrahkolie;Username=postgres;Password=CHANGE_ME

# حساب مدیر ارشد (در اولین راه‌اندازی ساخته می‌شود)
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=CHANGE_ME_STRONG

# محیط اجرا
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080

# رمز پایگاه داده برای سرویس Postgres در docker-compose
POSTGRES_PASSWORD=CHANGE_ME
